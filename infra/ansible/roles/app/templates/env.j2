# Managed by Ansible (roles/app) - edits here are overwritten by the next site.yml run.
DOCKERHUB_NAMESPACE={{ dockerhub_namespace }}

DB_HOST={{ tf.db_host.value }}
DB_NAME={{ tf.db_name.value }}
DB_USERNAME={{ db_app_username }}
DB_PASSWORD={{ tf.db_app_password.value }}

JWT_SECRET={{ tf.jwt_secret.value }}
APP_FRONTEND_URL={{ app_frontend_url }}

MAIL_HOST={{ mail_host }}
MAIL_PORT={{ mail_port }}
MAIL_USERNAME='{{ mail_username }}'
MAIL_PASSWORD='{{ mail_password }}'
MAIL_FROM='{{ mail_from }}'
