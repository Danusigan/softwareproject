# Database Configuration
# NOTE: DB_USERNAME must NOT be 'root' — the official MySQL image only lets you configure
# root via MYSQL_ROOT_PASSWORD, and rejects MYSQL_USER=root outright.
DB_USERNAME=appuser
DB_PASSWORD=test_password
DB_NAME=test_db

# Host port for the MySQL container. Change if 3306 is already in use locally (e.g. a local MySQL install).
DB_HOST_PORT=3306

# JWT signing secret — generate your own, do not reuse this or any example value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Spring Profile (dev, test, prod)
SPRING_PROFILE=dev

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=80

# MySQL
MYSQL_ROOT_PASSWORD=test_password
MYSQL_DATABASE=test_db
MYSQL_USER=appuser
MYSQL_PASSWORD=password
