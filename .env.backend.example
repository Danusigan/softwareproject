# Copy to .env.backend.local for scripts/start-backend.ps1.
# Literal NAME=value format; no quotes, interpolation or inline comments.
# Do not put server secrets in VITE_* variables or frontend files.
DB_URL=jdbc:mysql://localhost:3306/obqa?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
SPRING_PROFILES_ACTIVE=dev
APP_FRONTEND_URL=http://localhost:5173
# Optional SMTP credentials; leave blank when mail is not configured.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.test
